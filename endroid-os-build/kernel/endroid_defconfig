# Linux kernel configuration for Endroid OS
# Based on tinyconfig with additions for target hardware

CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_X86=y

# Tinyconfig baseline
# CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE is not set
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_KERNEL_LZ4=y

# Essential filesystems
CONFIG_EXT4_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_VFAT_FS=y
CONFIG_OVERLAY_FS=m

# Device filesystem
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y

# DRM/KMS for display (virtio-gpu for QEMU, add real drivers later)
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Storage drivers
CONFIG_ATA=y
CONFIG_AHCI=y
CONFIG_BLK_DEV_NVME=y
CONFIG_VIRTIO_BLK=y

# Input devices
CONFIG_INPUT_EVDEV=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_KEYBOARD=y
CONFIG_USB_MOUSE=y

# Networking
CONFIG_NET=y
CONFIG_INET=y
CONFIG_VIRTIO_NET=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_R8169=y

# Wireless (only if target has Wi-Fi)
# CONFIG_WIRELESS=y
# CONFIG_CFG80211=y
# CONFIG_MAC80211=y

# USB support
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y

# Console
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_TTY=y

# Power management
CONFIG_PM=y
CONFIG_ACPI=y

# Misc essentials
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_UNIX=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y

# Disable unnecessary features for size
# CONFIG_PRINTK is not set
# CONFIG_DMI is not set
